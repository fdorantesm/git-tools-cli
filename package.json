{
  "name": "git-tools-cli",
  "version": "0.1.0",
  "description": "Interactive tooling to automate Git workflows.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Fernando Dorantes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fdorantesm/git-tools-cli/issues"
  },
  "homepage": "https://github.com/fdorantesm/git-tools-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdorantesm/git-tools-cli.git"
  },
  "keywords": [
    "git",
    "cli",
    "cherry-pick",
    "automation"
  ],
  "contributors": [
    {
      "name": "Albert Hernandez",
      "url": "https://github.com/AlbertHernandez"
    }
  ],
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.9.4",
  "type": "commonjs",
  "scripts": {
    "dev": "vite build --watch",
    "prepublishOnly": "yarn build",
    "build": "yarn validate-typescript && yarn build:clean && vite build",
    "test": "rimraf coverage && yarn test:unit",
    "test:unit": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "yarn lint --fix",
    "lint:yaml": "chmod +x scripts/lint_yaml.sh && ./scripts/lint_yaml.sh",
    "validate-typescript": "tsc -p tsconfig.prod.json --noEmit",
    "build:clean": "rimraf dist; exit 0",
    "prepare": "husky",
    "typos": "chmod +x scripts/check_typos.sh && ./scripts/check_typos.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-vitest": "^0.5.4",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "inquirer": "^12.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.27.0"
  },
  "bin": {
    "git-tools": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "require": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  }
}
